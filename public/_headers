# Response headers for Cloudflare Workers Static Assets (this file is not served).
# no-cache: browsers check for a new copy on every load, so a deploy shows up at once.
# The CSP allows this site's own images and font and inline styles, and nothing else: no scripts, no other origins.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
